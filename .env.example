# LOICO Executive Report - Production Environment Variables
# In production on Vercel, set these in Vercel Project Settings -> Environment Variables.

# 1. Admin Authentication Password (Mandatory)
# Secret password required to access the /admin portal and publish reports.
ADMIN_PASSWORD=

# 2. Admin Session HMAC Secret (Mandatory in Production)
# Cryptographic secret key used to sign and verify admin session cookies.
ADMIN_SESSION_SECRET=

# 3. Central Cloud Storage (Mandatory in Production)
# Vercel Blob Read/Write Token or Blob Store ID injected when connecting Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# 4. Optional Gemini AI API Key
GEMINI_API_KEY=

# 5. Optional App URL
APP_URL=
